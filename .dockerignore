# What the image build does not need. The build context is the repository root
# (docker build -f apps/server/Dockerfile .), so these paths are from the root.

# Version control, CI and local tools
.git
.github
.claude

# Installed and built output: the image build installs and builds its own
**/node_modules
**/target
**/dist
apps/desktop/src-tauri/binaries
apps/desktop/src-tauri/gen

# Local state, notes and secrets: the updater's signing keys (.tauri/, wherever it is),
# environment files at any depth
docs/internal
ui-shots
**/.tauri
**/.env
**/.env.*
!**/.env.example
**/.DS_Store
**/*.log
