{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clerq",
  "version": "0.5.1",
  "identifier": "com.clerq.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OpenClerq",
        "width": 1024,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*",
        "frame-src": "http://127.0.0.1:* http://localhost:*",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "longDescription": "OpenClerq \u2014 local administrative agent. USE AT YOUR OWN RISK. No warranty. This app reads and writes config and API keys under ~/.clerq, may read paths you choose for modules, and if you configure an API key it will send requests to your chosen LLM provider. Calculations run locally. See the app About for full permissions and disclaimer.",
    "shortDescription": "OpenClerq \u2014 local clerical agent (use at your own risk)",
    "macOS": {
      "entitlements": "Entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "resources": {
      "../../../packages/plugin-chat/manifest.json": "bundled-plugins/chat/manifest.json"
    },
    "externalBin": ["binaries/clerq-gateway", "binaries/clerq-calc"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExOTRGNDRDQTI2Qjk0QzUKUldURmxHdWlUUFNVRVRhWldpZjk0Vk5jTWFGSC9ubDQzRURIYW0rMVFHWTdWamU4bk9xQWRNUkcK",
      "endpoints": ["https://github.com/paxamedia/OpenClerq/releases/latest/download/latest.json"]
    }
  }
}
