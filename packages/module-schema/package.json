    "./manifest.schema.json": "./manifest.schema.json",
    "./plugin-manifest.schema.json": "./plugin-manifest.schema.json"
  },
  "files": [
    "dist",
    "manifest.schema.json",
    "plugin-manifest.schema.json"
  ],
  "scripts": {
    "build": "tsc"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
