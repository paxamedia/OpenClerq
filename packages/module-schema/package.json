{
  "name": "@clerq/module-schema",
  "version": "0.5.1",
  "description": "Clerq module and plugin manifest schemas and types",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
