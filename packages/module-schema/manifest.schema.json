{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://clerq.dev/schemas/module-manifest.json",
  "title": "Clerq Module Manifest",
  "description": "Manifest for a pluggable Clerq module (removable, integratable)",
  "type": "object",
  "required": ["id", "slug", "name", "version"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique module identifier: lower-case words joined by single hyphens (e.g. my-module)",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "description": "Machine-readable slug, same as id typically",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "description": "Human-readable module name"
    },
    "version": {
      "type": "string",
      "description": "Semantic version or YYYY.Q (e.g. 0.1.0, 2026.1)",
      "pattern": "^(\\d+\\.\\d+(\\.\\d+)?|\\d{4}\\.\\d)$"
    },
    "description": {
      "type": "string",
      "description": "Short description of the module"
    },
    "entryPoints": {
      "type": "object",
      "description": "Entry points for UI, routes, task intents",
      "properties": {
        "ui": {
          "type": "string",
          "description": "Path to UI component (relative to module root)"
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Paths to route handler files"
        },
        "taskIntents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Task intent names this module handles (e.g. rate, payroll)"
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Capabilities this module provides"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Dependencies (e.g. clerq-core: >=0.1.0)"
    },
    "config": {
      "type": "object",
      "description": "Default settings, overlaid with the operator's ~/.clerq/modules/<id>.json"
    },
    "coreEndpoints": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(GET|POST|PUT|PATCH|DELETE) /[^\\s]+$"
      },
      "description": "Core endpoints the module's UI token may call, e.g. \"GET /runs/:id\""
    },
    "services": {
      "type": "array",
      "description": "launchd agents the module may start and stop",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": ["label"],
            "properties": {
              "label": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "plist": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "permissions": {
      "type": "object",
      "description": "What the module needs. Declared and shown to the operator; with enforcement on (Settings, Plugins) what a module does through its context is checked against it",
      "properties": {
        "exec": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fs": {
          "type": "object",
          "properties": {
            "read": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "write": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "net": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "llm": {
          "type": "boolean"
        },
        "api": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Core endpoints it calls, as METHOD /path; read together with coreEndpoints"
        },
        "memory": {
          "type": "object",
          "properties": {
            "read": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "write": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "description": "What the module adds to the shell",
      "properties": {
        "nav": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/extensionItem"
          }
        },
        "home.tile": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/extensionItem"
          }
        },
        "record.panel": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/extensionItem"
          }
        },
        "record.action": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/extensionItem"
          }
        },
        "search": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/extensionItem"
          }
        },
        "inbox.item": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/extensionItem"
          }
        },
        "settings.page": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/extensionItem"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "extensionItem": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "title": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "pattern": "^/",
          "description": "A path inside the module's UI, opened at #/m/<module>/<path>; {ref} stands for a record's ref"
        },
        "icon": {
          "type": "string"
        },
        "order": {
          "type": "number"
        },
        "size": {
          "enum": ["s", "m", "l"]
        },
        "types": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9_-]*$"
          },
          "description": "Record types as <module>:<type>, e.g. core:person"
        },
        "trigger": {
          "type": "string",
          "description": "record.action: the module trigger to fire with { ref }"
        },
        "confirm": {
          "type": "boolean"
        },
        "kind": {
          "enum": ["approval", "reply", "task", "alert"]
        }
      }
    }
  }
}
