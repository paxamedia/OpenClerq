{
  "name": "@clerq/module-sdk",
  "version": "0.5.1",
  "description": "Superseded by @clerq/plugin-sdk, which it re-exports: the types and helpers a pre-1.0 OpenClerq module is written against",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc --noEmit -p tsconfig.test.json && vitest run"
  },
  "dependencies": {
    "@clerq/plugin-sdk": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  }
}
