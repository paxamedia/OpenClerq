{
  "id": "hello-world",
  "slug": "hello-world",
  "name": "Hello world",
  "version": "0.1.0",
  "description": "The smallest module that uses the module platform: a route, a table, a secret, an event and a UI.",
  "config": {
    "greeting": "Hello"
  },
  "coreEndpoints": ["GET /runs", "GET /runs/:id", "GET /events/stream"],
  "services": [
    {
      "label": "org.example.hello-world.worker",
      "name": "Example worker"
    }
  ],
  "permissions": {
    "secrets": ["token"],
    "services": ["org.example.hello-world.worker"],
    "llm": false
  },
  "extensions": {
    "nav": [
      {
        "id": "main",
        "title": "Hello world",
        "path": "/"
      }
    ],
    "record.panel": [
      {
        "id": "greetings",
        "title": "Greetings",
        "types": ["core:person"],
        "path": "/?ref={ref}"
      }
    ],
    "record.action": [
      {
        "id": "count",
        "title": "Count greetings",
        "types": ["core:person"],
        "trigger": "count"
      }
    ],
    "search": [
      {
        "id": "greetings",
        "title": "Greetings",
        "types": ["hello-world:greeting"]
      }
    ]
  }
}
