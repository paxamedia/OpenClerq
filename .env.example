# OpenClerq — copy to .env and edit.
# Nothing here is required to start: the gateway generates what it needs.

# ---------------------------------------------------------------------------
# Gateway
# ---------------------------------------------------------------------------

# Bearer token for every endpoint except /health.
# Leave unset and the gateway generates one at ~/.clerq/gateway-token (mode 0600).
# Authenticate with:  Authorization: Bearer $(cat ~/.clerq/gateway-token)
# CLERQ_GATEWAY_TOKEN=

# Interface to bind. Defaults to 127.0.0.1.
# Widening this exposes tool execution to your network — put TLS in front of it
# and treat the token above as a production credential.
# CLERQ_HOST=127.0.0.1

# Port. Default 18790.
# CLERQ_PORT=18790

# Browser origins allowed to call the gateway (comma-separated). Defaults cover
# the Vite dev server and the Tauri webview. There is no wildcard option.
# CLERQ_CORS_ORIGINS=http://localhost:1420

# Maximum JSON request body. Default 1mb.
# CLERQ_MAX_BODY=1mb

# Development conveniences only. Does NOT disable authentication.
# CLERQ_DEV=1

# ---------------------------------------------------------------------------
# Language model
# ---------------------------------------------------------------------------

# Cloud (Anthropic)
# ANTHROPIC_API_KEY=sk-ant-...

# Or run locally with no key
# CLERQ_LLM_PROVIDER=ollama
# CLERQ_MODEL=llama3.2

# Or any OpenAI-compatible endpoint (LM Studio, vLLM, ...)
# CLERQ_LLM_PROVIDER=openai
# CLERQ_LLM_BASE_URL=http://localhost:1234/v1
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Secrets vault
# ---------------------------------------------------------------------------

# 32-byte hex key enabling the encrypted vault. Storing a master key in the
# environment is a known weakness (SECURITY.md finding); OS keychain storage
# replaces this before 1.0.
# CLERQ_VAULT_KEY=
