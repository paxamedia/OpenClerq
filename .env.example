# OpenClerq — copy to .env and edit.
# Nothing here is required to start: the gateway generates what it needs.

# ---------------------------------------------------------------------------
# Gateway
# ---------------------------------------------------------------------------

# Bearer token for every endpoint except /health.
# Leave unset and the gateway generates one at ~/.clerq/gateway-token (mode 0600).
# Authenticate with:  Authorization: Bearer $(cat ~/.clerq/gateway-token)
# CLERQ_GATEWAY_TOKEN=

# Interface to bind. Defaults to 127.0.0.1.
# Widening this exposes tool execution to your network — put TLS in front of it
# and treat the token above as a production credential.
# CLERQ_HOST=127.0.0.1

# Port. Default 18790.
# CLERQ_PORT=18790

# Browser origins allowed to call the gateway (comma-separated). Defaults cover
# the Vite dev server and the Tauri webview. There is no wildcard option.
# CLERQ_CORS_ORIGINS=http://localhost:1420

# Maximum JSON request body. Default 1mb.
# CLERQ_MAX_BODY=1mb

# Development conveniences only. Does NOT disable authentication.
# CLERQ_DEV=1

# ---------------------------------------------------------------------------
# Language model
# ---------------------------------------------------------------------------

# Pick a provider from the registry (docs/ARCHITECTURE.md, "Model providers"):
# anthropic (default), openai, deepseek, moonshot, zai, minimax, ollama, lmstudio.
# CLERQ_LLM_PROVIDER=anthropic
#
# Model id; leave unset for the provider's default. A qualified reference such
# as deepseek/deepseek-chat also selects the provider.
# CLERQ_MODEL=

# Keys, one per cloud vendor you use
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# ZAI_API_KEY=
# MINIMAX_API_KEY=

# Run locally with no key
# CLERQ_LLM_PROVIDER=ollama
# CLERQ_MODEL=llama3.2
# CLERQ_OLLAMA_URL=http://localhost:11434

# Or any OpenAI-compatible server (vLLM, llama.cpp, a proxy). Applies to the
# openai provider only; the key becomes optional.
# CLERQ_LLM_PROVIDER=openai
# CLERQ_LLM_BASE_URL=http://localhost:8000/v1

# Replace the built-in provider registry (models, base URLs, prices).
# Default: ~/.clerq/providers.yaml when it exists.
# CLERQ_PROVIDERS_FILE=

# ---------------------------------------------------------------------------
# Secrets vault
# ---------------------------------------------------------------------------

# The vault key now lives in the OS keychain, generated on first use. Set this
# only where there is no keychain to use — a container, say — and understand
# that any process able to read this environment can read the key.
# CLERQ_VAULT_KEY=

# Set to "off" to skip the keychain and use ~/.clerq/vault.key (mode 0600).
# CLERQ_KEYCHAIN=off
